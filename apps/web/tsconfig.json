{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "instrumentation.ts",
    "next.config.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "e2e/fixtures/**/*.ts",
    "e2e/golden-sequence.test.ts",
    "e2e/*.spec.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
