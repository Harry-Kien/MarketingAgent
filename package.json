{
  "name": "solo-marketing-os",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "dev:web": "npm run dev --workspace @smos/web",
    "typecheck": "tsc --build --verbose",
    "typecheck:web": "tsc --project apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "lint:versions": "node scripts/check-exact-versions.mjs",
    "lint:scope": "node scripts/check-forbidden-scope.mjs",
    "lint:secrets": "node scripts/scan-secrets.mjs",
    "lint:imports": "node scripts/check-imports.mjs",
    "lint:migrations": "node scripts/check-migrations.mjs",
    "lint:purity": "node scripts/check-domain-purity.mjs",
    "lint:authz": "node scripts/check-authz-purity.mjs",
    "lint:design": "node scripts/check-design-constraints.mjs",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "verify": "npm run lint:versions && npm run lint:scope && npm run lint:secrets && npm run lint:imports && npm run lint:migrations && npm run lint:purity && npm run lint:authz && npm run lint:design && npm run lint:i18n && npm run typecheck && npm run typecheck:web && npm run test"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
