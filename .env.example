# Copy to .env for local development. .env is git-ignored.
# These are local development values only. They are not secrets and must
# never be reused anywhere that matters.

NODE_ENV=development

# Host port 5433 avoids colliding with any PostgreSQL already on 5432.
#
# ADR-007: the application (and tests, via withTenant) connect as smos_app,
# a role with no BYPASSRLS -- never as the smos superuser.
DATABASE_URL=postgres://smos_app:smos_app_local_dev@127.0.0.1:5433/smos

# scripts/apply-migrations.mjs ONLY. Nothing else may use this URL: it
# connects as the smos superuser to run schema migrations and to set
# smos_app's password (below). The app, the worker and every test use
# DATABASE_URL instead.
DATABASE_MIGRATION_URL=postgres://smos:smos_local_dev@127.0.0.1:5433/smos

# Read by scripts/apply-migrations.mjs after migrations apply, to set
# smos_app's login password (never written into a migration file -- see
# infra/migrations/0002_smos_app_login.sql). Must match the password
# embedded in DATABASE_URL above.
SMOS_APP_PASSWORD=smos_app_local_dev

# apps/worker's own credential, distinct from DATABASE_URL (0017_outbox_claim_token.sql).
# smos_worker inherits every smos_app privilege via role membership, plus
# EXECUTE on outbox_claim_batch / outbox_mark_published, which smos_app does
# not have at all -- only the worker process should ever be able to drain
# the outbox across workspaces.
DATABASE_WORKER_URL=postgres://smos_worker:smos_worker_local_dev@127.0.0.1:5433/smos

# Read by scripts/apply-migrations.mjs after migrations apply, to set
# smos_worker's login password (never written into a migration file). Must
# match the password embedded in DATABASE_WORKER_URL above.
SMOS_WORKER_PASSWORD=smos_worker_local_dev

# packages/vault's own credential, distinct from both DATABASE_URL and
# DATABASE_WORKER_URL (0036_vault_secret.sql). smos_vault is a member of
# neither smos_app nor smos_worker and grants neither of them anything --
# this is the ONLY connection string that can reach vault_secret at all.
DATABASE_VAULT_URL=postgres://smos_vault:smos_vault_local_dev@127.0.0.1:5433/smos

# Read by scripts/apply-migrations.mjs after migrations apply, to set
# smos_vault's login password (never written into a migration file). Must
# match the password embedded in DATABASE_VAULT_URL above.
SMOS_VAULT_PASSWORD=smos_vault_local_dev

# packages/vault/src/providers/env-kms-provider.ts -- the LOCAL DEVELOPMENT
# key-encryption-key (KEK) provider. Each VAULT_KEK_<ID> is 32 random bytes,
# hex-encoded, one per KEK version; VAULT_ACTIVE_KEK_ID names which version
# wraps newly sealed data keys (unwrapping always uses whichever kek_id a
# given row was actually wrapped under, so retiring one is safe as long as
# every row wrapped under it has been rotated onto a newer one first, see
# packages/vault/src/vault-store.ts's rotateSecretKek).
#
# These two values are LOCAL DEVELOPMENT ONLY, exactly like
# BETTER_AUTH_SECRET above -- never reused anywhere real. A real deployment
# replaces EnvKmsProvider with a KmsProvider backed by an actual hosted KMS
# (AWS KMS / GCP KMS / HashiCorp Vault); nothing else in packages/vault
# changes.
VAULT_KEK_V1=c0be746ec69b09c642c98fba3c127782896f852abb481fdc3bab1299e395e316
VAULT_KEK_V2=91bc4cfdf45708b47f00238dfb6c21e72c48de8afb9aa40267739189910e5406
VAULT_ACTIVE_KEK_ID=v1

OTEL_SERVICE_NAME=smos-web
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# better-auth (apps/web/src/server/auth.ts). Local development value only --
# never reused anywhere real. better-auth uses this to sign/encrypt session
# cookies; rotating it invalidates every existing session.
BETTER_AUTH_SECRET=smos_local_dev_better_auth_secret_do_not_reuse
BETTER_AUTH_URL=http://localhost:3000

# apps/web's authentication surface only (0038_identity_tenancy_and_auth_role.sql).
# better-auth is the ONLY thing that connects with this URL: smos_auth holds
# the session/account/verification grants that smos_app deliberately no
# longer has, and it is a member of neither smos_app nor smos_vault, so a
# leaked DATABASE_URL cannot mint a session and a leaked DATABASE_AUTH_URL
# cannot reach any of this application's own data.
DATABASE_AUTH_URL=postgres://smos_auth:smos_auth_local_dev@127.0.0.1:5433/smos

# Read by scripts/apply-migrations.mjs after migrations apply, to set
# smos_auth's login password. Must match the password embedded in
# DATABASE_AUTH_URL above.
SMOS_AUTH_PASSWORD=smos_auth_local_dev
