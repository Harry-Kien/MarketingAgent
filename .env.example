# Copy to .env for local development. .env is git-ignored.
# These are local development values only. They are not secrets and must
# never be reused anywhere that matters.

NODE_ENV=development

# Host port 5433 avoids colliding with any PostgreSQL already on 5432.
#
# ADR-007: the application (and tests, via withTenant) connect as smos_app,
# a role with no BYPASSRLS -- never as the smos superuser.
DATABASE_URL=postgres://smos_app:smos_app_local_dev@127.0.0.1:5433/smos

# scripts/apply-migrations.mjs ONLY. Nothing else may use this URL: it
# connects as the smos superuser to run schema migrations and to set
# smos_app's password (below). The app, the worker and every test use
# DATABASE_URL instead.
DATABASE_MIGRATION_URL=postgres://smos:smos_local_dev@127.0.0.1:5433/smos

# Read by scripts/apply-migrations.mjs after migrations apply, to set
# smos_app's login password (never written into a migration file -- see
# infra/migrations/0002_smos_app_login.sql). Must match the password
# embedded in DATABASE_URL above.
SMOS_APP_PASSWORD=smos_app_local_dev

# apps/worker's own credential, distinct from DATABASE_URL (0017_outbox_claim_token.sql).
# smos_worker inherits every smos_app privilege via role membership, plus
# EXECUTE on outbox_claim_batch / outbox_mark_published, which smos_app does
# not have at all -- only the worker process should ever be able to drain
# the outbox across workspaces.
DATABASE_WORKER_URL=postgres://smos_worker:smos_worker_local_dev@127.0.0.1:5433/smos

# Read by scripts/apply-migrations.mjs after migrations apply, to set
# smos_worker's login password (never written into a migration file). Must
# match the password embedded in DATABASE_WORKER_URL above.
SMOS_WORKER_PASSWORD=smos_worker_local_dev

OTEL_SERVICE_NAME=smos-web
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
